<file path="frontend/src/styles/theme.css">
:root {
  
  --mango-primary: var(--color-gold);
  --mango-primary-dark: var(--color-gold-dark);
  --mango-green: var(--color-orchard);
  --mango-green-light: #4a8f5c;
  --mango-cream: var(--color-bg);
  --text-dark: var(--color-ink);
  --text-muted: var(--color-bark);
  --border: var(--color-border);
  --radius: var(--radius-lg);
  --shadow-sm: var(--shadow-sm);
  --shadow-lg: var(--shadow-md);
}

* { box-sizing: border-box; }
body { margin: 0; font-family: var(--font-body); color: var(--text-dark); }

.text-gradient {
  background: linear-gradient(90deg, var(--mango-primary), var(--mango-green-light));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 11px 22px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
}
.btn--primary { background: var(--mango-primary); color: #fff; box-shadow: var(--shadow-sm); }
.btn--primary:hover { background: var(--mango-primary-dark); transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.btn--ghost { background: transparent; color: var(--text-dark); border-color: var(--border); }
.btn--ghost:hover { border-color: var(--mango-primary); color: var(--mango-primary-dark); }
.btn--white { background: #fff; color: var(--mango-green); }
.btn--white:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.btn--lg { padding: 14px 30px; font-size: 1.02rem; }
.btn--block { width: 100%; }
.btn__spinner {
  width: 18px; height: 18px; border-radius: 50%;
  border: 3px solid rgba(255,255,255,0.4); border-top-color: #fff;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ---------- Home: nav ---------- */
.home__nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 6vw; position: sticky; top: 0; z-index: 20;
  background: rgba(255, 253, 250, 0.85); backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}
.navbar__brand { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 1.15rem; }
.navbar__logo { font-size: 1.4rem; }
.home__nav-actions { display: flex; gap: 12px; }

/* ---------- Hero ---------- */
.home__hero {
  position: relative; text-align: center; padding: 130px 6vw 100px; overflow: hidden;
  background-image:
    linear-gradient(180deg, rgba(30, 74, 39, 0.82) 0%, rgba(30, 74, 39, 0.55) 45%, rgba(255, 253, 250, 0.97) 96%),
    url('/images/hero-mango.jpg');
  background-size: cover;
  background-position: center 35%;
  background-repeat: no-repeat;
  color: #fff;
}
.home__hero-glow {
  position: absolute; top: -120px; left: 50%; transform: translateX(-50%);
  width: 600px; height: 400px; border-radius: 50%;
  background: radial-gradient(circle, rgba(232,163,23,0.3), transparent 70%);
  filter: blur(20px); z-index: 0;
}
.home__eyebrow {
  position: relative; z-index: 1; display: inline-block; margin-bottom: 18px;
  padding: 6px 16px; border-radius: 999px; background: rgba(255,255,255,0.16);
  border: 1px solid rgba(255,255,255,0.35); backdrop-filter: blur(6px);
  color: #fff; font-weight: 600; font-size: 0.85rem;
}
.home__hero h1 {
  position: relative; z-index: 1; font-size: clamp(2rem, 4.5vw, 3.2rem);
  line-height: 1.15; max-width: 900px; margin: 0 auto 20px; font-weight: 800;
  color: #fff;
}
.home__hero h1::after { display: none; }
.home__hero .text-gradient {
  background: linear-gradient(90deg, var(--color-gold), #ffe4a3);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.home__hero-subtitle {
  position: relative; z-index: 1; max-width: 640px; margin: 0 auto 32px;
  color: rgba(255,255,255,0.9); font-size: 1.08rem; line-height: 1.6;
}
.home__hero-actions { position: relative; z-index: 1; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
.home__hero-badges {
  position: relative; z-index: 1; display: flex; gap: 22px; justify-content: center;
  flex-wrap: wrap; color: rgba(255,255,255,0.85); font-size: 0.9rem; font-weight: 500;
}

/* ---------- Stats ---------- */
.home__stats {
  display: flex; justify-content: center; gap: 60px; flex-wrap: wrap;
  padding: 40px 6vw; background: var(--mango-green); color: #fff;
}
.home__stat { text-align: center; }
.home__stat-value { font-size: 2.2rem; font-weight: 800; }
.home__stat-label { font-size: 0.9rem; opacity: 0.85; }

/* ---------- Sections ---------- */
.home__section { padding: 80px 6vw; text-align: center; }
.home__section--muted { background: var(--mango-cream); }
.home__section-tag { color: var(--mango-primary-dark); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; }
.home__section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 10px 0 12px; font-weight: 800; }
.home__section-subtitle { color: var(--text-muted); max-width: 560px; margin: 0 auto 48px; }

.home__features { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; max-width: 1100px; margin: 0 auto; }
.card {
  background: #fff; border: 1px solid var(--border); border-radius: var(--radius);
  padding: 32px 26px; text-align: left; box-shadow: var(--shadow-sm);
}
.card--hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
.card--hover:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
.card__icon { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border-radius: 14px; font-size: 1.5rem; margin-bottom: 16px; }
.card__icon--green { background: #eafaf0; }
.card__icon--orange { background: #fff3df; }
.card__icon--blue { background: #eaf2ff; }
.card h3 { margin: 0 0 8px; font-size: 1.1rem; }
.card__meta { color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; margin: 0; }

.home__steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; max-width: 1000px; margin: 0 auto; }
.home__step { text-align: left; padding: 0 10px; }
.home__step-number {
  width: 42px; height: 42px; border-radius: 50%; background: var(--mango-primary); color: #fff;
  display: flex; align-items: center; justify-content: center; font-weight: 800; margin-bottom: 16px;
}
.home__step h3 { margin: 0 0 8px; }

.home__cta {
  position: relative; text-align: center; padding: 70px 6vw; margin: 0 6vw 80px;
  border-radius: 28px; overflow: hidden; color: #fff;
  background-image:
    linear-gradient(120deg, rgba(30,74,39,0.92), rgba(232,163,23,0.55)),
    url('/images/cta-orchard.jpg');
  background-size: cover;
  background-position: center;
}
.home__cta h2 { font-size: 1.8rem; margin-bottom: 10px; }
.home__cta p { opacity: 0.9; margin-bottom: 26px; }

.home__footer { text-align: center; padding: 36px 6vw 50px; color: var(--text-muted); }
.home__footer-copy { font-size: 0.85rem; margin-top: 10px; }

/* ---------- Auth pages ---------- */
.auth-page { min-height: 100vh; background: var(--mango-cream); }
.auth-shell { display: grid; grid-template-columns: 0.85fr 1.15fr; min-height: 100vh; }

.auth-side {
  position: relative; overflow: hidden; padding: 56px 48px;
  background-image:
    linear-gradient(165deg, rgba(30,74,39,0.92) 0%, rgba(74,143,92,0.82) 100%),
    url('/images/auth-bg.jpg');
  background-size: cover;
  background-position: center;
  color: #fff; display: flex; flex-direction: column; justify-content: center;
}
.auth-side__brand { color: #fff; text-decoration: none; font-weight: 800; display: flex; align-items: center; gap: 8px; margin-bottom: 40px; font-size: 1.1rem; }
.auth-side__title { font-size: 1.8rem; line-height: 1.3; margin-bottom: 16px; }
.auth-side__text { opacity: 0.9; line-height: 1.6; margin-bottom: 28px; }
.auth-side__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; font-weight: 500; }
.auth-side__glow { position: absolute; width: 300px; height: 300px; border-radius: 50%; background: rgba(255,159,28,0.25); filter: blur(40px); bottom: -80px; right: -80px; }

.auth-main { display: flex; align-items: center; justify-content: center; padding: 40px 24px; }
.auth-card {
  width: 100%; max-width: 620px; background: #fff; border-radius: var(--radius);
  padding: 40px; box-shadow: var(--shadow-lg); border: 1px solid var(--border);
}
.auth-card__brand--mobile { display: none; font-weight: 800; margin-bottom: 12px; }
.auth-card h1 { margin: 0 0 6px; font-size: 1.6rem; }
.auth-card__subtitle { color: var(--text-muted); margin: 0 0 24px; }

.status { padding: 12px 16px; border-radius: 10px; font-size: 0.9rem; margin-bottom: 20px; }
.status--error { background: #fdecea; color: #b3261e; border: 1px solid #f7c9c4; }
.status--reminder {
  display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  background: #fff8ef; color: var(--text-dark); border: 1px solid #f3d9a8;
}
.status--reminder .btn-primary { padding: 8px 16px; white-space: nowrap; }
.role-select { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 26px; }
.role-card {
  display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center;
  border: 2px solid var(--border); border-radius: 12px; padding: 14px 8px; background: #fff;
  cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease;
}
.role-card__icon { font-size: 1.4rem; }
.role-card__label { font-weight: 700; font-size: 0.88rem; }
.role-card__desc { font-size: 0.72rem; color: var(--text-muted); }
.role-card--active { border-color: var(--mango-primary); background: #fff8ef; }

.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; margin-bottom: 26px; }
.field-grid--single { grid-template-columns: 1fr; }
.field { display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem; font-weight: 600; color: var(--text-dark); }
.field input, .field select {
  padding: 11px 14px; border-radius: 10px; border: 1.5px solid var(--border);
  font-size: 0.95rem; font-weight: 400; transition: border-color 0.15s ease;
}
.field input:focus, .field select:focus { outline: none; border-color: var(--mango-primary); }
.field__password { position: relative; display: flex; }
.field__password input { flex: 1; padding-right: 40px; }
.field__password-toggle { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 1rem; }

.auth-card__footer { text-align: center; margin-top: 20px; color: var(--text-muted); font-size: 0.9rem; }
.auth-card__footer a { color: var(--mango-primary-dark); font-weight: 600; text-decoration: none; }

/* ---------- Page banner (dashboard headers) ---------- */
.page-banner {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  padding: 40px 36px;
  margin: 24px 0 32px;
  color: #fff;
  background-size: cover;
  background-position: center;
  box-shadow: var(--shadow-md);
}
.page-banner::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(120deg, rgba(30,74,39,0.88) 0%, rgba(42,31,20,0.45) 100%);
}
.page-banner--farmer { background-image: url('/images/farmer-banner.jpg'); }
.page-banner--trader { background-image: url('/images/trader-banner.jpg'); }
.page-banner--admin  { background-image: url('/images/admin-banner.jpg'); }

.page-banner__content { position: relative; z-index: 1; }
.page-banner__eyebrow {
  display: inline-block; margin-bottom: 12px; padding: 5px 14px; border-radius: 999px;
  background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.35);
  font-weight: 600; font-size: 0.82rem;
}
.page-banner h1 {
  color: #fff; margin: 0 0 8px; font-size: clamp(1.5rem, 3vw, 2rem);
}
.page-banner h1::after { background: rgba(255,255,255,0.6); }
.page-banner__subtitle { margin: 0; color: rgba(255,255,255,0.9); font-size: 0.98rem; max-width: 560px; }
.page-banner__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
.page-banner__actions .btn-primary {
  background: var(--color-gold); color: #2a1f14;
}
.page-banner__actions .btn-primary:hover { background: var(--color-gold-dark); color: #fff; }

@media (max-width: 640px) {
  .page-banner { padding: 30px 22px; }
}

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .auth-shell { grid-template-columns: 1fr; }
  .auth-side { display: none; }
  .auth-card__brand--mobile { display: block; }
  .field-grid { grid-template-columns: 1fr; }
  .role-select { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .home__hero { padding: 60px 6vw 50px; }
  .home__cta { margin: 0 4vw 60px; padding: 50px 24px; }
}
