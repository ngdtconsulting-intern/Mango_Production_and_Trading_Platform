.responses { color: var(--color-bark); font-size: 13px; }

.btn-apply {
  padding: 10px 20px;
  background: linear-gradient(90deg, var(--color-gold), var(--color-gold-dark));
  color: #2a1f14;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: 700;
  font-size: 13px;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
  box-shadow: 0 4px 12px rgba(232, 163, 23, 0.35);
}
.btn-apply:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(232, 163, 23, 0.45); }

/* ---------- Standalone form (Post a Requirement) ---------- */
.application-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
  position: relative;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  padding: 32px;
  overflow: hidden;
}

.application-form::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 5px;
  background: linear-gradient(90deg, var(--color-orchard), var(--color-gold));
}

.form-group { display: flex; flex-direction: column; }
.form-group label { margin: 0 0 6px; }
.form-group input,
.form-group textarea {
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-family: inherit;
  background: var(--color-bg);
}
.form-group input:focus,
.form-group textarea:focus { border-color: var(--color-orchard); outline: none; }

.modal-actions { display: flex; gap: 12px; }

.btn-submit, .btn-cancel {
  flex: 1;
  padding: 12px;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: 700;
  font-size: 14px;
  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s ease;
}

.btn-submit {
  background: linear-gradient(90deg, var(--color-orchard), var(--color-orchard-dark));
  color: #fff;
  box-shadow: 0 6px 16px rgba(47, 107, 60, 0.28);
}
.btn-submit:hover:not(:disabled) { transform: translateY(-1px); }
.btn-submit:disabled { opacity: 0.6; cursor: not-allowed; box-shadow: none; }

.btn-cancel {
  background: var(--color-bg);
  color: var(--color-ink);
  border: 1px solid var(--color-border);
}
.btn-cancel:hover { background: #f3ead2; }

/* ---------- Modal (Apply for requirement) ---------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(30, 27, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal-content {
  position: relative;
  background: var(--color-surface);
  padding: 30px;
  border-radius: var(--radius-lg);
  max-width: 500px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}

.modal-content::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 5px;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: linear-gradient(90deg, var(--color-orchard), var(--color-gold));
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.modal-header h2 { margin: 0; font-size: 20px; }

.close-btn {
  background: var(--color-bg);
  border: none;
  width: 32px; height: 32px;
  border-radius: 50%;
  font-size: 16px;
  cursor: pointer;
  color: var(--color-bark);
  display: flex; align-items: center; justify-content: center;
}
.close-btn:hover { background: #f3ead2; color: var(--color-ink); }

/* ---------- Status legend (used on trader dashboard) ---------- */
.status-guide {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  margin-bottom: 24px;
}
.status-guide p {
  font-size: 13px;
  color: var(--color-bark);
  margin: 4px 0;
}

/* Contact panel shown once a request is accepted */
.contact-panel {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--color-border);
}

.contact-panel-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--color-bark);
  margin-bottom: 8px;
}

@media (max-width: 768px) {
  .filters-section { grid-template-columns: 1fr; }
  .application-form { padding: 24px 20px; }
}
