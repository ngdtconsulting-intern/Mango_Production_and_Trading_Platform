.farmer-directory-container .filters-section {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 18px;
  margin-bottom: 30px;
  background: var(--color-surface);
  padding: 22px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.farmer-directory-container .filter-group { display: flex; flex-direction: column; }
.farmer-directory-container .filter-group label { margin: 0 0 6px; }
.farmer-directory-container .filter-group select,
.farmer-directory-container .filter-group input {
  padding: 10px 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 14px;
  background: var(--color-bg);
}
.farmer-directory-container .filter-group select:focus,
.farmer-directory-container .filter-group input:focus {
  border-color: var(--color-orchard);
  outline: none;
}

.farmer-directory-container .loading { color: var(--color-bark); font-style: italic; }
.farmer-directory-container .empty-message {
  text-align: center;
  padding: 60px 20px;
  color: var(--color-bark);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  border: 1px dashed var(--color-border);
}

/* ---------- Farmer cards ---------- */
.farmers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 18px;
}

.farmer-card {
  position: relative;
  background: var(--color-surface);
  padding: 22px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-orchard);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.farmer-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

.farmer-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.farmer-header h3 {
  margin: 0;
  font-size: 17px;
}

.farmer-header h3::before {
  content: '👨‍🌾';
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  margin-right: 10px;
  background: linear-gradient(135deg, var(--color-gold), var(--color-orchard));
  font-size: 15px;
}

.farmer-info p {
  margin: 8px 0;
  color: var(--color-bark);
  font-size: 13.5px;
  line-height: 1.5;
}
.farmer-info strong { color: var(--color-ink); }

.farmer-contacts {
  display: flex;
  gap: 10px;
  margin: 16px 0;
  flex-wrap: wrap;
}

.contact-btn {
  flex: 1;
  padding: 9px 10px;
  border-radius: var(--radius-sm);
  text-align: center;
  text-decoration: none;
  font-size: 12.5px;
  font-weight: 600;
  min-width: 100px;
  transition: all 0.15s ease;
}

.contact-btn.phone {
  border: 1px solid var(--color-orchard);
  color: var(--color-orchard-dark);
  background: #eaf5ee;
}
.contact-btn.phone:hover { background: var(--color-orchard); color: #fff; }

.contact-btn.email {
  border: 1px solid var(--color-gold);
  color: var(--color-gold-dark);
  background: #fdf6e6;
}
.contact-btn.email:hover { background: var(--color-gold); color: #2a1f14; }

.btn-profile {
  width: 100%;
  padding: 11px;
  background: linear-gradient(90deg, var(--color-orchard), var(--color-orchard-dark));
  color: #fff;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: 700;
  font-size: 13.5px;
  box-shadow: 0 4px 12px rgba(47, 107, 60, 0.25);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.btn-profile:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(47, 107, 60, 0.32); }

@media (max-width: 768px) {
  .farmers-grid { grid-template-columns: 1fr; }
  .farmer-directory-container .filters-section { grid-template-columns: 1fr; }
}
